{
  "name": "pb-ts-zod",
  "version": "1.0.0",
  "description": "Generate Zod 4 (or Zod 3) schemas and TypeScript types from PocketBase collections — offline from a SQLite file or pb_schema.json, or live from a running instance. Zero native dependencies.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "pb-ts-zod": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pocketbase",
    "zod",
    "zod4",
    "typescript",
    "schema",
    "codegen",
    "typegen",
    "validation",
    "types",
    "sqlite",
    "offline",
    "cli"
  ],
  "author": "Martin Blasko <martin@blasko.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinBspheroid/pb-zod.git"
  },
  "homepage": "https://github.com/MartinBspheroid/pb-zod#readme",
  "bugs": {
    "url": "https://github.com/MartinBspheroid/pb-zod/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "zod": "^3.20.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
